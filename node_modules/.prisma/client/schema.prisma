generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  imageUrl  String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos    Photo[]

  @@map("users")
}

model Photo {
  id           String      @id @default(cuid())
  userId       String
  source       PhotoSource @default(GOOGLE_PHOTOS)
  sourceItemId String?     @unique
  imageUrl     String
  thumbnailUrl String?
  takenAt      DateTime?
  lat          Float?
  lon          Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exifData     ExifData?
  weatherData  WeatherData?
  speciesLinks PhotoSpecies[]

  @@index([userId])
  @@index([takenAt])
  @@index([lat, lon])
  @@map("photos")
}

model ExifData {
  id            String    @id @default(cuid())
  photoId       String    @unique
  cameraMake    String?
  cameraModel   String?
  lensModel     String?
  iso           Int?
  aperture      Float?
  shutter       String?
  focalLength   Float?
  originalTaken DateTime?
  timezone      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@map("exif_data")
}

model WeatherData {
  id            String   @id @default(cuid())
  photoId       String   @unique
  temperatureC  Float?
  pressureHpa   Float?
  windKph       Float?
  precipitation Float?
  weatherCode   Int?
  source        String   @default("open-meteo")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@map("weather_data")
}

model Species {
  id          String         @id @default(cuid())
  slug        String         @unique
  displayName String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  photoLinks  PhotoSpecies[]

  @@map("species")
}

model PhotoSpecies {
  id             String   @id @default(cuid())
  photoId        String
  speciesId      String
  confidence     Float?
  manualOverride Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  photo   Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@unique([photoId, speciesId])
  @@index([speciesId])
  @@map("photo_species")
}

enum Role {
  MEMBER
  ADMIN
}

enum PhotoSource {
  GOOGLE_PHOTOS
}
